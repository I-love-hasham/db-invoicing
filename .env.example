# Copy to .env with scripts/generate_env.py (it fills in random secrets).
# .env is excluded from git, the Docker image, and any shared backups. chmod 600.
SECRET_KEY=
AUDIT_HMAC_KEY=
ENCRYPTION_KEY=
SETUP_TOKEN=
COOKIE_SECURE=1
TRUST_PROXY_HEADERS=1
APP_TIMEZONE=America/New_York

# Microsoft 365 email (send-only from billing@). Email stays off until all three are set
# and secrets/m365.pem (private key + certificate, chmod 600) exists. See README.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_SENDER=
